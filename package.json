{
  "name": "temp-turbo",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/manage.ts dev",
    "start": "bun run scripts/manage.ts start",
    "stop": "bun run scripts/manage.ts stop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:ai": "bun run scripts/test-ai.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.13",
    "prettier": "^3.7.4",
    "turbo": "^2.9.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
